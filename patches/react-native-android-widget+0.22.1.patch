+    /**
+     * A request code no other click PendingIntent of this app holds. Every click intent has the same
+     * action and component, so the request code alone tells them apart: a code shared by two buttons
+     * (two registrations within one millisecond with the time as the code) made the second one cancel
+     * the first, leaving a button that does nothing. Counting up from the time keeps the codes unique
+     * in this process and clear of the ones an earlier process left on the launcher.
+     */
+    public static int nextClickRequestCode() {
+        int now = (int) System.currentTimeMillis();
+        return lastRequestCode.updateAndGet(last -> now - last > 0 ? now : last + 1);
+    }
