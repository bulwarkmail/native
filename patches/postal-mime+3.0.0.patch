+// React Native's Blob cannot be built from ArrayBuffers or typed arrays, so
+// the decoders join their chunks here instead of through a Blob.
+export function concatChunks(chunks) {
+    const parts = chunks.map(chunk => {
+        if (typeof chunk === 'string') return textEncoder.encode(chunk);
+        if (chunk instanceof ArrayBuffer) return new Uint8Array(chunk);
+        return new Uint8Array(chunk.buffer, chunk.byteOffset, chunk.byteLength);
+    });
+    const out = new Uint8Array(parts.reduce((n, part) => n + part.byteLength, 0));
+    let pos = 0;
+    for (const part of parts) {
+        out.set(part, pos);
+        pos += part.byteLength;
+    }
+    return out.buffer;
+}
