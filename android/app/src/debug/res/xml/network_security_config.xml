<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds load the bundle from Metro over http, which the main config
  forbids (a network security config replaces the manifest's
  usesCleartextTraffic). Same trust anchors as the release config.
-->
<network-security-config>
  <base-config cleartextTrafficPermitted="true">
    <trust-anchors>
      <certificates src="system" />
      <certificates src="user" />
    </trust-anchors>
  </base-config>
</network-security-config>
